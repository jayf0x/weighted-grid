{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["bun-types"],
    "paths": {
      "weighted-grid/react": ["./src/react.tsx"],
      "weighted-grid/presets": ["./src/presets/index.ts"],
      "weighted-grid/core": ["./src/core.ts"],
      "weighted-grid": ["./src/index.ts"]
    }
  },
  // The demo has its own tsconfig (Vite client types, its own React install) — running it through
  // this program too gave duplicate-`@types/react` errors for no gain. `demo/src/showcases/report.ts`
  // still gets checked here: `scripts/dev/dev-report-grid.ts` imports it, and TS follows imports.
  "include": ["src", "tests", "scripts"]
}
