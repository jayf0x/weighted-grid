{
  "name": "weighted-grid",
  "version": "1.6.1",
  "type": "module",
  "description": "A React grid that sizes items by relative weight and fills empty space automatically, rendered as native CSS Grid.",
  "author": "jayF0x",
  "license": "MIT",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build --config config/vite.config.ts",
    "dev": "vite build --watch --config config/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "bun run build",
    "test": "bun test",
    "test:run": "bun test",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "scan": "bash ./scripts/opengrep-scan.sh",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "demo:dev": "cd demo && bun install && bun run dev",
    "demo:deploy": "bash ./scripts/deploy-pages.sh",
    "npm:deploy": "bash ./scripts/npm/publish-npm.sh",
    "repo:bootstrap": "bash ./scripts/bootstap.sh",
    "size": "size-limit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@size-limit/file": "^11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "bun-types": "^1.3.14",
    "byte-snap": "^1.1.3",
    "plugin-include": "^1.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "size-limit": "^11",
    "taglify": "^1.2.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "6 kB"
    }
  ],
  "keywords": [
    "react",
    "grid",
    "react-grid",
    "grid-layout",
    "css-grid",
    "bento-grid",
    "masonry",
    "masonry-layout",
    "dashboard-grid",
    "gallery",
    "responsive-grid",
    "weighted-layout",
    "elastic-layout",
    "flexbox",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayf0x/weighted-grid.git"
  },
  "homepage": "https://github.com/jayf0x/weighted-grid#readme",
  "bugs": {
    "url": "https://github.com/jayf0x/weighted-grid/issues"
  }
}
